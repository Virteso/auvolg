PIPELINE=production
STATIC_DIR=/staticfiles

# HAProxy settings
# DOMAIN is used for the HTTP -> HTTPS redirect target in production.
DOMAIN=example.com
# Host ports mapped to container ports 80/443. The container always binds
# 80/443 internally (net.ipv4.ip_unprivileged_port_start=80, no root needed).
PORT_HTTP=80
PORT_HTTPS=443

# TLS certificates are NOT obtained automatically. Put a PEM bundle
# (certificate chain + private key) at haproxy/certs/site.pem and rebuild
# the haproxy image. See haproxy/certs/README.md.

# Mailing server
EMAIL_PORT=465
EMAIL_HOST_USER=user
EMAIL_HOST_PASSWORD=user_pw
EMAIL_DEFAULT_FROM=user@example.com
PASSWORD_RESET_TIMEOUT=259200   # Password reset link validity in seconds (default 259200 = 3 days)
